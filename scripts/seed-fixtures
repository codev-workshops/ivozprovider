#!/usr/bin/env bash
#
# Load the fixtures the call tests assume into a running baseline stack.
#
# schema/initial.sql and the Doctrine migrations are applied by the containers
# themselves (docker/mariadb/Dockerfile and docker/backend/start.sh). What they
# leave behind is an empty platform: no brands, no companies, no users. The
# telephony fixtures - the tests/bbs/environment.yaml users, the residential and
# retail brands, DDIs, IVRs, queues, hunt groups, conferences and call forward
# settings - live in tests/bbs/dataset.json, a Postman collection that creates
# them all through the REST API. This runs it.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=scripts/lib/baseline.sh
source "${ROOT}/scripts/lib/baseline.sh"

RESULTS_DIR=${RESULTS_DIR:-${ROOT}/results/seed}
mkdir -p "${RESULTS_DIR}"

echo "Seeding tests/bbs/dataset.json through ${BASELINE_API_BASE}..."

set +e
baseline_newman run tests/bbs/dataset.json \
    --env-var "platform_api_url=${BASELINE_API_BASE}/platform" \
    --env-var "brand_api_url=${BASELINE_API_BASE}/brand" \
    --env-var "client_api_url=${BASELINE_API_BASE}/client" \
    --env-var "api_username=${BASELINE_API_USERNAME}" \
    --env-var "api_password=${BASELINE_API_PASSWORD}" \
    --reporters cli,junit \
    --reporter-junit-export "results/seed/dataset.xml" \
    --timeout-request 30000
status=$?
set -e

# The dataset pins the DDI provider addresses and the carrier to the public
# addresses of Irontec's own BBS runner. On this stack the tester is a container
# on the compose network, so both have to point at it: inbound scenarios only
# get past proxytrunks if the caller is a trusted DDI provider address, and
# outbound ones need the carrier to route back to the tester. Done through the
# API rather than with SQL so kam_trusted is rebuilt the same way it would be in
# production.
echo
echo "Pointing the BBS carrier and DDI provider at ${BASELINE_BBS_ADDRESS}..."

platform_token=$(baseline_platform_token)
brand_token=$(baseline_brand_token "${platform_token}")

collection_ids() {
    baseline_api "${brand_token}" GET "$1" |
        python3 -c 'import json,sys; print(" ".join(str(i["id"]) for i in json.load(sys.stdin)))'
}

for id in $(collection_ids /brand/ddi_provider_addresses); do
    baseline_api "${brand_token}" PUT "/brand/ddi_provider_addresses/${id}" \
        "{\"ip\":\"${BASELINE_BBS_ADDRESS}\"}" >/dev/null
done

for id in $(collection_ids /brand/carrier_servers); do
    baseline_api "${brand_token}" PUT "/brand/carrier_servers/${id}" \
        "{\"sipProxy\":\"${BASELINE_BBS_ADDRESS}\"}" >/dev/null
done

# On a real deployment the ivozprovider-realtime microservice watches the
# database and pushes these reloads to each proxy as objects change. The
# baseline has no realtime service, so the caches are refreshed here
# instead, once, after the fixtures are in place.
for proxy in users trunks; do
    for rpc in domain.reload dispatcher.reload permissions.addressReload; do
        baseline_compose exec -T "kamailio-${proxy}" \
            kamcmd -s "unix:/run/kamailio/kamailio_proxy${proxy}_ctl" "${rpc}" \
            >/dev/null 2>&1 || echo "  ${proxy}: ${rpc} not available" >&2
    done
done

echo
echo "Seeded objects:"
baseline_mysql "
    SELECT 'Brands', COUNT(*) FROM Brands
    UNION ALL SELECT 'Companies', COUNT(*) FROM Companies
    UNION ALL SELECT 'Users', COUNT(*) FROM Users
    UNION ALL SELECT 'Terminals', COUNT(*) FROM Terminals
    UNION ALL SELECT 'DDIs', COUNT(*) FROM DDIs
    UNION ALL SELECT 'IVRs', COUNT(*) FROM IVRs
    UNION ALL SELECT 'Queues', COUNT(*) FROM Queues
    UNION ALL SELECT 'HuntGroups', COUNT(*) FROM HuntGroups
    UNION ALL SELECT 'ConferenceRooms', COUNT(*) FROM ConferenceRooms
    UNION ALL SELECT 'ResidentialDevices', COUNT(*) FROM ResidentialDevices
    UNION ALL SELECT 'RetailAccounts', COUNT(*) FROM RetailAccounts
"

echo
echo "JUnit report: ${RESULTS_DIR}/dataset.xml"
exit "${status}"
