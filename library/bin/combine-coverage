#!/usr/bin/env php
<?php

use SebastianBergmann\CodeCoverage\CodeCoverage;
use SebastianBergmann\CodeCoverage\Report\Html\Facade;
use SebastianBergmann\CodeCoverage\Report\Clover;

require __DIR__ . '/../vendor/autoload.php';

$root = dirname(__DIR__, 2);

// Every coverage.php report that may have been generated by the different
// component test suites. Missing files are skipped so the combined report can
// still be produced from whatever is available.
$fileList = [
    $root . '/library/spec/coverage/coverage.php',
    $root . '/schema/tests/coverage/coverage.php',
    $root . '/microservices/recordings/tests/coverage/coverage.php',
    $root . '/web/rest/platform/features/coverage/coverage.php',
    $root . '/web/rest/brand/features/coverage/coverage.php',
    $root . '/web/rest/client/features/coverage/coverage.php',
    $root . '/web/rest/user/features/coverage/coverage.php',
    $root . '/web/rest/platform/tests/coverage/coverage.php',
    $root . '/web/rest/brand/tests/coverage/coverage.php',
    $root . '/web/rest/client/tests/coverage/coverage.php',
    $root . '/web/rest/user/tests/coverage/coverage.php',
];

/** @var CodeCoverage|null $mainReport */
$mainReport = null;

foreach ($fileList as $file) {
    if (!file_exists($file)) {
        echo "skip (not found): $file\n";
        continue;
    }

    echo "merge: $file\n";
    $coverageReport = require $file;

    // The installed sebastian/code-coverage requires a driver + filter to be
    // constructed, so we cannot instantiate an empty CodeCoverage to merge
    // into. Instead we use the first loaded report as the base.
    if ($mainReport === null) {
        $mainReport = $coverageReport;
    } else {
        $mainReport->merge($coverageReport);
    }
}

if ($mainReport === null) {
    fwrite(STDERR, "No coverage reports were found.\n");
    exit(1);
}

$report = $mainReport->getReport();
$executable = $report->numberOfExecutableLines();
$executed = $report->numberOfExecutedLines();
$percent = $executable > 0 ? ($executed / $executable) * 100 : 0.0;

printf("\nCombined line coverage: %.2f%% (%d/%d lines)\n", $percent, $executed, $executable);

$htmlReport = new Facade();
$htmlReport->process(
    $mainReport,
    __DIR__ . '/../combined-coverage/'
);

// Portable, review-friendly artefacts committed to the repository. The full
// HTML tree (combined-coverage/) is large and embeds absolute machine paths, so
// it stays git-ignored; the Clover XML below has the repository root stripped so
// its file paths are relative and diff-able.
$reportDir = $root . '/docs/coverage-report';
if (!is_dir($reportDir)) {
    mkdir($reportDir, 0777, true);
}

$clover = (new Clover())->process($mainReport);
$clover = str_replace($root . '/', '', $clover);
file_put_contents($reportDir . '/clover.xml', $clover);

printf("Wrote Clover report to %s\n", $reportDir . '/clover.xml');
