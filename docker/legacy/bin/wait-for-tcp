#!/bin/bash
# Block until <host> <port> accepts a TCP connection, or give up after
# <timeout> seconds (default 180).
set -euo pipefail

host=$1
port=$2
timeout=${3:-180}

for _ in $(seq "$timeout"); do
    if nc -z -w 2 "$host" "$port" 2>/dev/null; then
        exit 0
    fi
    sleep 1
done

echo "wait-for-tcp: ${host}:${port} did not become reachable in ${timeout}s" >&2
exit 1
