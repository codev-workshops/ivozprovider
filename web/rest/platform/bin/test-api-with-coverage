#!/bin/bash

set -e

# Collect code coverage while running the Behat API suite.
# Requires a coverage driver (Xdebug/PCOV) in coverage mode; the
# Service\Behat\CoverageContext is inert unless COVERAGE is set.
export APP_ENV=test
export COVERAGE=1
export XDEBUG_MODE=coverage

pushd /opt/irontec/ivozprovider/web/rest/platform
    if [ "$1" != "--skip-db" ]; then
        bin/prepare-test-db
    fi

    vendor/bin/behat -f progress
popd
